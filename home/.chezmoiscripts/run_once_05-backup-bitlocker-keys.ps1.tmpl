#Requires -Version 7.0
# home/.chezmoiscripts/run_once_05-backup-bitlocker-keys.ps1
# chezmoi run_once_ script: store BitLocker recovery keys in 1Password
# Runs exactly once per machine. Re-run by clearing chezmoi script state.

$ErrorActionPreference = 'Stop'

# ─── Self-elevate if not running as Administrator ─────────────────────────────
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    $argList = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    Start-Process pwsh -Verb RunAs -ArgumentList $argList -Wait
    exit 0
}

function Write-Log { param([string]$Msg) Write-Host "[bitlocker-backup] $Msg" }

# ─── Skip in CI ───────────────────────────────────────────────────────────────
if ($env:CI) {
    Write-Log "[CI] Skipping BitLocker key backup."
    exit 0
}

# ─── Vault selection based on profile ────────────────────────────────────────
$profile_ = "{{ .profile }}"
$vault = if ($profile_ -eq 'work') { 'Kobo' } else { 'Personal' }
Write-Log "Profile: $profile_ — storing keys in vault: $vault"

# ─── Check if BitLocker is available ─────────────────────────────────────────
if (-not (Get-Command Get-BitLockerVolume -ErrorAction SilentlyContinue)) {
    Write-Log "BitLocker cmdlets not available. Skipping."
    exit 0
}

# ─── Check if op CLI is available ─────────────────────────────────────────────
if (-not (Get-Command op -ErrorAction SilentlyContinue)) {
    Write-Log "1Password CLI (op) not found. Skipping."
    exit 0
}

# ─── Find encrypted volumes with recovery keys ────────────────────────────────
$volumes = Get-BitLockerVolume | Where-Object { $_.ProtectionStatus -eq 'On' }

if (-not $volumes) {
    Write-Log "No BitLocker-protected volumes found. Skipping."
    exit 0
}

$hostname = $env:COMPUTERNAME

foreach ($volume in $volumes) {
    $drive = $volume.MountPoint.TrimEnd('\')
    $recoveryKey = $volume.KeyProtector |
        Where-Object { $_.KeyProtectorType -eq 'RecoveryPassword' } |
        Select-Object -First 1

    if (-not $recoveryKey) {
        Write-Log "No recovery key found for $drive. Skipping."
        continue
    }

    $itemTitle = "BitLocker Recovery Key — $hostname $drive"
    $keyValue  = $recoveryKey.RecoveryPassword

    # Check if item already exists in 1Password
    $existing = op item get $itemTitle --vault $vault 2>$null
    if ($existing) {
        Write-Log "1Password item already exists for $drive. Skipping."
        continue
    }

    Write-Log "Storing recovery key for $drive in 1Password vault '$vault'..."
    op item create `
        --category "Secure Note" `
        --title $itemTitle `
        --vault $vault `
        "notesPlain=$keyValue"

    Write-Log "Recovery key for $drive stored successfully."
}

Write-Log "BitLocker key backup complete."
