# .chezmoiignore — Platform-specific file exclusions

# Exclude macOS-specific files on non-macOS systems
{{ if ne .chezmoi.os "darwin" }}
dot_hushlogin
dot_config/alacritty
{{ end }}

# Exclude Windows-specific files and scripts on non-Windows systems
{{ if ne .chezmoi.os "windows" }}
AppData/
Documents/
.chezmoiscripts/*.ps1
.chezmoiscripts/*.ps1.tmpl
{{ end }}

# Exclude Linux/macOS shell files on Windows
{{ if eq .chezmoi.os "windows" }}
dot_zshrc.tmpl
.chezmoiscripts/*.sh
.chezmoiscripts/*.sh.tmpl
{{ end }}
