{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "closeTab"
            },
            "id": "User.closeTab.0"
        },
        {
            "command": 
            {
                "action": "globalSummon",
                "desktop": "toCurrent",
                "dropdownDuration": 1,
                "monitor": "toMouse",
                "name": "_quake",
                "toggleVisibility": true
            },
            "id": "User.globalSummon.2BB56DE6"
        }
    ],
    "compatibility.allowHeadless": true,
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "disableAnimations": true,
    "keybindings": 
    [
        {
            "id": "Terminal.OpenNewTab",
            "keys": "ctrl+t"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+shift+tab"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+tab"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },
        {
            "id": "User.closeTab.0",
            "keys": "ctrl+w"
        },
        {
            "id": "User.globalSummon.2BB56DE6",
            "keys": "win+`"
        }
    ],
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": 
    {
        "defaults": 
        {
            "colorScheme": "One Half Dark",
            "cursorColor": "#57BAFB",
            "cursorShape": "bar",
            "font": 
            {
                "face": "JetBrainsMono Nerd Font",
                "size": {{ if .is_work }}12{{ else }}13{{ end }}
            },
            "historySize": 99999,
            "opacity": 50,
            "padding": "8, 8, 8, 8",
            "scrollbarState": "hidden",
            "useAcrylic": true
        },
        "list": 
        [
            {
                "commandline": "pwsh.exe -NoLogo",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": false,
                "icon": "ms-appx:///ProfileIcons/pwsh.png",
                "name": "PowerShell"
            },
            {
                "colorScheme": "One Half Dark (Admin)",
                "commandline": "pwsh.exe -NoLogo",
                "elevate": true,
                "guid": "{a1b2c3d4-e5f6-7890-abcd-ef1234567890}",
                "hidden": false,
                "icon": "ms-appx:///ProfileIcons/pwsh.png",
                "name": "PowerShell (Admin)"
            },
            {
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": false,
                "name": "Command Prompt"
            }{{ if eq .chezmoi.os "windows" }},
            {
                "commandline": "wsl.exe -d Ubuntu",
                "guid": "{5265de91-ba16-45c9-92b4-13cd1a9d286a}",
                "hidden": false,
                "icon": "{{ .chezmoi.homeDir | replace "\\" "/" }}/.config/terminal-icons/ubuntu.png",
                "name": "Ubuntu",
                "startingDirectory": "~",
                "suppressApplicationTitle": true
            }{{ end }}
        ]
    },
    "schemes": 
    [
        {
            "background": "#001B26",
            "black": "#282C34",
            "blue": "#61AFEF",
            "brightBlack": "#5A6374",
            "brightBlue": "#61AFEF",
            "brightCyan": "#56B6C2",
            "brightGreen": "#98C379",
            "brightPurple": "#C678DD",
            "brightRed": "#E06C75",
            "brightWhite": "#DCDFE4",
            "brightYellow": "#E5C07B",
            "cursorColor": "#E06C75",
            "cyan": "#56B6C2",
            "foreground": "#DCDFE4",
            "green": "#98C379",
            "name": "One Half Dark (Admin)",
            "purple": "#C678DD",
            "red": "#E06C75",
            "selectionBackground": "#FFFFFF",
            "white": "#DCDFE4",
            "yellow": "#E5C07B"
        }
    ],
    "themes": [],
    "useAcrylicInTabRow": false,
    "windowingBehavior": "useAnyExisting"
}