# Windows PowerShell 7 Profile — managed by chezmoi
# Target: $HOME/Documents/PowerShell/Microsoft.PowerShell_profile.ps1
#Requires -Version 7.0

# ─── PSReadLine ────────────────────────────────────────────────────────────
Import-Module PSReadLine -ErrorAction SilentlyContinue

# ─── Command Not Found ─────────────────────────────────────────────────────
#f45873b3-b655-43a6-b217-97c00aa0db58 PowerToys CommandNotFound module
Import-Module -Name Microsoft.WinGet.CommandNotFound
#f45873b3-b655-43a6-b217-97c00aa0db58

#Set-PSReadLineOption -EditMode Windows
Set-PSReadLineOption -PredictionSource History
Set-PSReadLineOption -PredictionViewStyle ListView
Set-PSReadLineOption -BellStyle None
Set-PSReadLineKeyHandler -Key Tab -Function MenuComplete
Set-PSReadLineKeyHandler -Key UpArrow   -Function HistorySearchBackward
Set-PSReadLineKeyHandler -Key DownArrow -Function HistorySearchForward
Set-PSReadLineKeyHandler -Chord 'Ctrl+p' -Function HistorySearchBackward
Set-PSReadLineKeyHandler -Chord 'Ctrl+n' -Function HistorySearchForward

# ─── Starship ──────────────────────────────────────────────────────────────
# Expose elevation status so starship env_var module can show lightning icon
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($isAdmin) { $env:IS_ADMIN = "1" } else { Remove-Item Env:IS_ADMIN -ErrorAction SilentlyContinue }

if (Get-Command starship -ErrorAction SilentlyContinue) {
    $env:STARSHIP_CONFIG = "$HOME/.config/starship/starship-al.toml"
    function Invoke-Starship-TransientFunction { &starship module custom.transient_character }
    Invoke-Expression (&starship init powershell)
    Enable-TransientPrompt
}

function prompt-al {
    $env:STARSHIP_CONFIG = "$HOME/.config/starship/starship-al.toml"
    Invoke-Expression (&starship init powershell)
    Enable-TransientPrompt
}
function prompt-minimal {
    $env:STARSHIP_CONFIG = "$HOME/.config/starship/starship-minimal.toml"
    Invoke-Expression (&starship init powershell)
    Enable-TransientPrompt
}

# ─── Aliases ───────────────────────────────────────────────────────────────
Set-Alias -Name g   -Value git
Set-Alias -Name v   -Value nvim
Set-Alias -Name vi  -Value nvim
Set-Alias -Name vim -Value nvim
Set-Alias -Name cz  -Value chezmoi

function ll  { eza -l --icons --git @args }
function la  { eza -la --icons --git @args }
function lt  { eza --tree --icons @args }
function ..  { Set-Location .. }
function ... { Set-Location ../.. }

function gs  { git status @args }
function gd  { git diff @args }
function gl  { git log --oneline --graph --decorate @args }
function gp  { git push @args }
function gpl { git pull @args }
function gc  { git commit @args }
function gco { git checkout @args }

# ─── fzf ──────────────────────────────────────────────────────────────────
if (Get-Command fzf -ErrorAction SilentlyContinue) {
    $env:FZF_DEFAULT_COMMAND = 'fd --type f --hidden --follow --exclude .git'
    $env:FZF_DEFAULT_OPTS    = '--height 40% --reverse --border'
}

# ─── direnv ────────────────────────────────────────────────────────────────
if (Get-Command direnv -ErrorAction SilentlyContinue) {
    Invoke-Expression "$(direnv hook pwsh)"
}

# ─── Profile-specific ─────────────────────────────────────────────────────
{{ if .is_work }}
$env:WORK_ENV = 'true'
# Work-specific PATH additions
$workBin = Join-Path $env:USERPROFILE '.work\bin'
if (Test-Path $workBin) { $env:PATH = "$workBin;$env:PATH" }
{{ end }}

{{ if .is_gaming }}
$env:GAMING_ENV = 'true'
{{ end }}

# ─── Utility functions ─────────────────────────────────────────────────────
function which { Get-Command $args[0] | Select-Object -ExpandProperty Source }
function touch { New-Item -ItemType File -Path $args[0] -Force | Out-Null }

function Set-DotfilesProfile {
    param([ValidateSet('common','gaming','work')][string]$Profile)
    chezmoi edit-config
    Write-Host "Edit data.profile in the config file, then run: chezmoi apply"
}
Set-Alias -Name dotfiles-set-profile -Value Set-DotfilesProfile

# ─── Starting directory ────────────────────────────────────────────────────
# If no launcher set a directory (fell back to System32), go home.
# Launchers like Total Commander pass their panel directory, which is preserved.
# Configure Windows Terminal's default startingDirectory to "~" so normal
# terminal opens also start at home without relying on this fallback.
if ($PWD.Path -eq "$env:SystemRoot\System32") { Set-Location ~ }

Write-Host "pwsh $($PSVersionTable.PSVersion) | Profile: {{ .profile }} | Host: {{ .hostname }}" -ForegroundColor DarkGray
