# Ensure consistent line endings
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
*.sh.tmpl text eol=lf

# PowerShell scripts use CRLF on Windows, LF elsewhere
*.ps1 text eol=lf
*.ps1.tmpl text eol=lf

# Config / data files
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.tmpl text eol=lf

# Dockerfiles
Dockerfile* text eol=lf

# Stub binaries (must be LF for Linux execution)
tests/stubs/op text eol=lf
