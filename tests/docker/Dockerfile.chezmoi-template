FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root
ENV CI=true

# Install base dependencies + chezmoi
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        wget \
        git \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

# Install chezmoi via official script
RUN sh -c "$(curl -fsLS get.chezmoi.io)" -- -b /usr/local/bin

# Copy the repo
COPY . /repo
RUN chmod +x /repo/tests/docker/entrypoint-template.sh \
             /repo/tests/stubs/op

# Put stub op binary on PATH
ENV PATH="/repo/tests/stubs:${PATH}"

WORKDIR /repo

ENTRYPOINT ["/repo/tests/docker/entrypoint-template.sh"]
